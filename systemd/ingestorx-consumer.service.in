[Unit]
Description=IngestorX - consumidor downstream
After=network-online.target ingestorx-watcher.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=__WORKDIR__/.env
ExecStart=__WORKDIR__/target/release/consumer
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__WORKDIR__/dados

[Install]
WantedBy=default.target
